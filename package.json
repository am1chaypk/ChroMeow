{
  "name": "chromeow",
  "version": "1.1.0",
  "private": true,
  "description": "ChroMeow — a 100% local-first, zero-telemetry interactive cat simulator that lives inside your Chrome viewport.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "APK",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
